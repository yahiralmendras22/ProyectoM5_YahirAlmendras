{
  "name": "github-ai-agent",
  "version": "1.0.0",
  "description": "MCP Server que expone tools para automatizar operaciones de GitHub desde un agente de IA usando lenguaje natural",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "model-context-protocol", "github", "ai-agent", "octokit"],
  "author": "Yahir Almendras",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}